# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional SMTP configuration for the /api/contact email endpoint.
# When omitted, the server validates requests and reports SMTP unconfigured without simulating delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
CONTACT_TO_EMAIL="lalchandalibd@gmail.com"
